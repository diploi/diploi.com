---
import { HardDrivesIcon } from '@phosphor-icons/react';
import { PricingTable, PricingType } from '../../../components';
import FeaturesSection from '../../features/_components/FeaturesSection.astro';
import FeaturesSectionHeader from '../../features/_components/FeaturesSectionHeader.astro';
import PricingDeployments from './PricingDeployments.astro';

const { pricing } = await fetch('https://console.diploi.com/api/business/pricing').then((response) => response.json());
if (!pricing) {
  throw new Error(`Failed to load pricing (${pricing.status})`);
}
---

<FeaturesSection>
  <FeaturesSectionHeader slot="header">
    <HardDrivesIcon />
    <h2>Cluster Costs</h2>
    <p>
      A running Diploi deployment spins up a cluster that runs everything to do with your stack. Cluster costs are paid from your balance,
      you are only charged for the hours your cluster is running.
    </p>
  </FeaturesSectionHeader>

  <PricingDeployments />

  <PricingType pricing={pricing} />
  <PricingTable pricing={pricing} />
</FeaturesSection>
